{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "nursery": {
        "useTailwindSortedClasses": {
          "fix": "safe",
          "level": "error"
        }
      },
      "suspicious": {
        "noUnknownAtRules": {
          "level": "error",
          "options": {
            "ignore": [
              "tailwind",
              "apply",
              "config",
              "custom-variant",
              "keyframes",
              "layer",
              "plugin",
              "reference",
              "source",
              "theme",
              "utility",
              "variant"
            ]
          }
        }
      }
    }
  },
  "tailwind": {
    "attributes": ["css", "class", "classList", "classNames", "className"],
    "mergeFunctions": ["clsx", "tw", "twMerge", "cn"],
    "variantFunctions": ["cva", "tv"]
  }
}
